# Secrets — never commit tokens; the sync script reads them from your
# harness MCP config (~/.claude.json) or TANA_MCP_TOKEN env var.
.env
.env.*

# Harness-local state
.claude/settings.local.json
.DS_Store
__pycache__/
*.pyc

# Scratch / local experiments
_scratch/

# Personal configuration — created from vn-config.example.yaml on first run.
# Holds your workspace id, archive path and catalog vocabulary: never commit it.
vn-config.yaml
